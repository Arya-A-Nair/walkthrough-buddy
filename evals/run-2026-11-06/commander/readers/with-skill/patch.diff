diff --git a/tests/help.suggestion.test.js b/tests/help.suggestion.test.js
index 92046e6..91e453e 100644
--- a/tests/help.suggestion.test.js
+++ b/tests/help.suggestion.test.js
@@ -1,6 +1,6 @@
 import { test, describe } from 'node:test';
 import assert from 'node:assert/strict';
-import { Command, Option } from '../index.js';
+import { Argument, Command, InvalidArgumentError, Option } from '../index.js';
 
 // Note: setting up shared command configuration in getSuggestion,
 // and looking for possible subcommand 'sub'.
@@ -248,4 +248,82 @@ describe('Command.showSuggestionAfterError()', () => {
     const suggestion = getSuggestion(program, ['sub', '--hepl']);
     assert.equal(suggestion, '--help');
   });
+  describe('choices suggestions', () => {
+    test('when option value close to one choice then suggest it', () => {
+      const program = new Command();
+      program.addOption(
+        new Option('--colour <shade>').choices(['red', 'blue']),
+      );
+      const suggestion = getSuggestion(program, ['--colour', 'rde']);
+      assert.equal(suggestion, 'red');
+    });
+
+    test('when option value close to several choices then suggest all', () => {
+      const program = new Command();
+      program.addOption(
+        new Option('--pet <kind>').choices(['car', 'cat', 'dog']),
+      );
+      const suggestion = getSuggestion(program, ['--pet', 'cax']);
+      assert.equal(suggestion, 'car, cat');
+    });
+
+    test('when option value not close to any choice then no suggestion', () => {
+      const program = new Command();
+      program.addOption(
+        new Option('--colour <shade>').choices(['red', 'blue']),
+      );
+      const suggestion = getSuggestion(program, ['--colour', 'green']);
+      assert.equal(suggestion, null);
+    });
+
+    test('when variadic option value close to choice then suggest it', () => {
+      const program = new Command();
+      program.addOption(
+        new Option('--colour <shade...>').choices(['red', 'blue']),
+      );
+      const suggestion = getSuggestion(program, ['--colour', 'red', 'bleu']);
+      assert.equal(suggestion, 'blue');
+    });
+
+    test('when env value close to choice then suggest it', (t) => {
+      process.env.COLOUR = 'rde';
+      t.after(() => delete process.env.COLOUR);
+      const program = new Command();
+      program.addOption(
+        new Option('--colour <shade>').choices(['red', 'blue']).env('COLOUR'),
+      );
+      const suggestion = getSuggestion(program, []);
+      assert.equal(suggestion, 'red');
+    });
+
+    test('when argument value close to choice then suggest it', () => {
+      const program = new Command();
+      program
+        .addArgument(new Argument('<shade>').choices(['red', 'blue']))
+        .action(() => {});
+      const suggestion = getSuggestion(program, ['bleu']);
+      assert.equal(suggestion, 'blue');
+    });
+
+    test('when subcommand argument value close to choice then suggest it', () => {
+      const program = new Command();
+      program
+        .command('sub')
+        .addArgument(new Argument('<shade>').choices(['red', 'blue']))
+        .action(() => {});
+      const suggestion = getSuggestion(program, ['sub', 'rde']);
+      assert.equal(suggestion, 'red');
+    });
+
+    test('when custom argParser throws then no suggestion', () => {
+      const program = new Command();
+      program.addOption(
+        new Option('--colour <shade>').argParser(() => {
+          throw new InvalidArgumentError('Nope.');
+        }),
+      );
+      const suggestion = getSuggestion(program, ['--colour', 'rde']);
+      assert.equal(suggestion, null);
+    });
+  });
 });
