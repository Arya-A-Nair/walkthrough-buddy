diff --git a/tests/help.suggestion.choices.test.js b/tests/help.suggestion.choices.test.js
new file mode 100644
index 0000000..cde3d51
--- /dev/null
+++ b/tests/help.suggestion.choices.test.js
@@ -0,0 +1,109 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { Command, Option, Argument, InvalidArgumentError } from '../index.js';
+
+function getError(program, args) {
+  let message = '';
+  program.exitOverride().configureOutput({
+    writeErr: (str) => {
+      message += str;
+    },
+  });
+  let error;
+  try {
+    program.parse(args, { from: 'user' });
+  } catch (err) {
+    error = err;
+  }
+  return { message, error };
+}
+
+describe('suggestion for value not in choices', () => {
+  test('when option value close to a choice then suggestion appended', () => {
+    const program = new Command();
+    program.addOption(new Option('--colour <shade>').choices(['red', 'blue']));
+    const { message, error } = getError(program, ['--colour', 'rde']);
+    assert.equal(
+      message,
+      "error: option '--colour <shade>' argument 'rde' is invalid. Allowed choices are red, blue.\n(Did you mean red?)\n",
+    );
+    assert.equal(error.code, 'commander.invalidArgument');
+    assert.equal(error.exitCode, 1);
+  });
+
+  test('when several choices equally close then all suggested', () => {
+    const program = new Command();
+    program.addOption(new Option('--pet <pet>').choices(['cat', 'car', 'dog']));
+    const { message } = getError(program, ['--pet', 'cax']);
+    assert.match(message, /\(Did you mean one of car, cat\?\)\n$/);
+  });
+
+  test('when option value from env close to a choice then suggestion appended', () => {
+    const program = new Command();
+    program.addOption(
+      new Option('--colour <shade>')
+        .choices(['red', 'blue'])
+        .env('SUGGEST_CHOICES_COLOUR'),
+    );
+    process.env.SUGGEST_CHOICES_COLOUR = 'blu';
+    try {
+      const { message } = getError(program, []);
+      assert.match(message, /\(Did you mean blue\?\)\n$/);
+    } finally {
+      delete process.env.SUGGEST_CHOICES_COLOUR;
+    }
+  });
+
+  test('when argument value close to a choice then suggestion appended', () => {
+    const program = new Command();
+    program
+      .addArgument(new Argument('<size>').choices(['small', 'large']))
+      .action(() => {});
+    const { message } = getError(program, ['smal']);
+    assert.equal(
+      message,
+      "error: command-argument value 'smal' is invalid for argument 'size'. Allowed choices are small, large.\n(Did you mean small?)\n",
+    );
+  });
+
+  test('when nothing close then message unchanged', () => {
+    const program = new Command();
+    program.addOption(new Option('--colour <shade>').choices(['red', 'blue']));
+    const { message } = getError(program, ['--colour', 'orange']);
+    assert.equal(
+      message,
+      "error: option '--colour <shade>' argument 'orange' is invalid. Allowed choices are red, blue.\n",
+    );
+  });
+
+  test('when showSuggestionAfterError(false) inherited by subcommand then no suggestion', () => {
+    let message = '';
+    const program = new Command()
+      .showSuggestionAfterError(false)
+      .exitOverride()
+      .configureOutput({ writeErr: (str) => (message += str) });
+    program
+      .command('sub')
+      .addOption(new Option('--colour <shade>').choices(['red', 'blue']))
+      .action(() => {});
+    assert.throws(
+      () => program.parse(['sub', '--colour', 'rde'], { from: 'user' }),
+      {
+        code: 'commander.invalidArgument',
+      },
+    );
+    assert.match(message, /Allowed choices are red, blue\.\n$/);
+  });
+
+  test('when custom argParser throws then message unchanged', () => {
+    const program = new Command();
+    program.option('--colour <shade>', 'colour', () => {
+      throw new InvalidArgumentError('Bad.');
+    });
+    const { message } = getError(program, ['--colour', 'rde']);
+    assert.equal(
+      message,
+      "error: option '--colour <shade>' argument 'rde' is invalid. Bad.\n",
+    );
+  });
+});
